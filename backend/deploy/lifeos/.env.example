# Copy to .env on the VPS. Never commit the real file.
OMI_HOST=omi.example.com

# Generate a long random value.
REDIS_PASSWORD=replace-me
ENCRYPTION_SECRET=replace-me
ADMIN_KEY=replace-me

# Own Firebase/GCP project used by the LifeOS Omi fork.
FIREBASE_PROJECT_ID=replace-me
FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
FIRESTORE_DATABASE_ID=(default)
FIREBASE_API_KEY=replace-me

# Minimum useful provider set. Add others only when the feature needs them.
DEEPGRAM_API_KEY=replace-me
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Omi features that still depend on their current search/index integrations.
# Leave blank only if the corresponding feature is intentionally disabled.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
TYPESENSE_HOST=
TYPESENSE_HOST_PORT=
TYPESENSE_API_KEY=

# LifeOS canonical storage/synthesis bridge. Do not expose the service-role key
# to the mobile app; it belongs only on the server.
LIFEOS_SUPABASE_URL=
LIFEOS_SUPABASE_SERVICE_ROLE_KEY=
